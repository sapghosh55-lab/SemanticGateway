# Gateway Settings
HOST=0.0.0.0
PORT=8000
ROUTES_FILE=routes.yaml
SIMILARITY_THRESHOLD=0.45
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Fast Lane Tier (Groq Llama 3 8B)
FAST_MODEL_NAME=llama3-8b-8192
FAST_MODEL_BASE_URL=https://api.groq.com/openai/v1
FAST_MODEL_API_KEY=your_groq_api_key_here
FAST_MODEL_COST_PER_1K_INPUT=0.0001
FAST_MODEL_COST_PER_1K_OUTPUT=0.0002

# Deep Lane / Cloud Frontier Tier (Groq Llama 3.3 70B)
DEEP_MODEL_NAME=llama-3.3-70b-versatile
DEEP_MODEL_BASE_URL=https://api.groq.com/openai/v1
DEEP_MODEL_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

DEEP_MODEL_COST_PER_1K_INPUT=0.0059
DEEP_MODEL_COST_PER_1K_OUTPUT=0.0079
FRONTIER_MODEL_COST_PER_1K_INPUT=0.0059
FRONTIER_MODEL_COST_PER_1K_OUTPUT=0.0079
